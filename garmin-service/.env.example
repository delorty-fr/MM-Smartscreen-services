# Garmin Service Configuration

# Server Configuration
GARMIN_API_HOST=127.0.0.1
GARMIN_API_PORT=8000

# Garmin Credentials (required for unattended restarts after token expiry)
# These are used for automatic re-login if tokens expire beyond 24 hours
# (e.g., after system restart after a week)
# WARNING: Storing passwords on disk is a security risk. Only use in trusted environments.
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-password

# Token Storage Path (default: ~/.garminconnect)
GARMIN_TOKEN_PATH=~/.garminconnect

# Token Refresh Threshold in seconds (default: 300 = 5 minutes)
# How long before token expiry to trigger a refresh
GARMIN_TOKEN_REFRESH_THRESHOLD=300

# Enable Stub Mode (default: false)
# When true, the service will return mock data instead of making real API calls to Garmin Connect
GARMIN_STUB_MODE=false